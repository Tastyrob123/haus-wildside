, "gleich": 1}, {"h": "42d21d4b0c", "n": 0, "tag": "p", "t": "Wenn es warm ist, stehen Tische vor der Tür, an der Ecke Haasemannstraße und Rampenstraße. Drinnen läuft die Bar, draussen der Abend in Linden.", "zu": "", "vor": "Draussen an der Ecke", "ober": "", "gleich": 1}], "fotos": [{"b": "pl-theke", "n": 0, "alt": "Momo hinter der Theke, unter der Kante das gelbe Lichtband", "zu": "", "klein": "assets/bild/pl-theke-480.webp?v=31108", "neu": false}, {"b": "pl-tisch", "n": 0, "alt": "Drinks am Holztisch, im Hintergrund die Polsterbank", "zu": "", "klein": "assets/bild/pl-tisch-480.webp?v=31108", "neu": false}, {"b": "pl-empore", "n": 0, "alt": "Die lange Tafel auf der Empore, gedeckt mit Grün", "zu": "", "klein": "assets/bild/pl-empore-480.webp?v=31108", "neu": false}, {"b": "pl-ecke", "n": 0, "alt": "Die Ecke Haasemannstraße und Rampenstraße mit dem Schild der Bar", "zu": "", "klein": "assets/bild/pl-ecke-480.webp?v=31108", "neu": false}]}, {"h": "896bc63eca", "n": 0, "titel": "Derya und Momo.", "tag": "section", "fest": false, "zu": "", "aus": false, "stellen": [{"h": "3e88b97d15", "n": 0, "tag": "span", "t": "Wer hinter der Bar steht", "zu": "", "vor": "", "ober": "", "gleich": 1}, {"h": "59124ea4f0", "n": 0, "tag": "span", "t": "Zwei Leute", "zu": "", "vor": "Wer hinter der Bar steht", "ober": "", "gleich": 1}, {"h": "cbc70ad203", "n": 0, "tag": "span", "t": "Derya und Momo.", "zu": "", "vor": "Zwei Leute", "ober": "", "gleich": 1}, {"h": "cc3692191c", "n": 0, "tag": "h3", "t": "Derya Ivkin", "zu": "", "vor": "Derya und Momo.", "ober": "", "gleich": 1}, {"h": "1026420b02", "n": 0, "tag": "span", "t": "führt die Bar", "zu": "", "vor": "Derya Ivkin", "ober": "", "gleich": 1}, {"h": "2ec4520484", "n": 0, "tag": "p", "t": "Seit Herbst 2023 gehört die Bar ihr und Momo. Sie entscheidet, wer auflegt, wer kocht und wann die Empore gedeckt wird.", "zu": "", "vor": "führt die Bar", "ober": "Derya Ivkin", "gleich": 1}, {"h": "9085c9034d", "n": 0, "tag": "span", "t": "2023