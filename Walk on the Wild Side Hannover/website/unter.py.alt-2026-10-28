              ('Kann ich die Bar für eine Feier mieten?', 'Die lange Tafel für eure Runde, oder über den Event Klub die ganze Bar.')]
    faq = '''<section class="kap b-faq"><div class="innen bf-gr"><div><h2 class="titel zl auf">%s</h2><div class="bf-bild">%s</div></div><div class="bf-liste">%s</div></div></section>''' % (
