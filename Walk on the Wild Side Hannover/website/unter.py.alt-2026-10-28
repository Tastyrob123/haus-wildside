# ---------------------------------------------------------------- Programm
POSTER = {'17.10.2026': 'p-1710', '03.10.2026': 'p-0310', '05.09.2026': 'p-0509', '16.05.2026': 'p-1605', '21.03.2026': 'p-2103', '24.01.2026': 'p-2401', '22.11.2025': 'p-2211', '06.09.2025': 'p-0906'}


