    aussen = [('31.10. und 01.11.2026', 'Oktoberfest des Event Klub am Stephansplatz, 12 bis 21 Uhr', 'bald'),
              ('09.08.2026', 'Smash n Mingle beim HTV, mit Musa und Tru Story', ''), ('13. und 14.06.2026', 'Südstadtfest, Cocktailstand mit dem Mon Bonheur', ''),
              ('14. und 15.05.2026', 'Christi Limmerfahrt am Küchengarten', ''), ('31.07.2025', 'Maschseefest, Stand Aresto x Lindenblatt', ''),
              ('29. und 30.05.2025', 'Christi Limmerfahrt am Küchengarten', ''), ('09.05.2024', 'Christi Limmerfahrt, Kiezfest am Küchengarten', '')]
    unterwegs = '''<section class="kap p-aussen"><div class="innen pa-gr"><div><h2 class="titel zl auf">%s</h2><p class="vtext sw auf" style="--i:1">Manchmal kommt die Bar zu euch: Momo mixt auf den Festen in Linden und der Südstadt.</p></div>
<ul class="pa-liste sw auf" style="--i:2">%s</ul></div></section>''' % (zl('Unterwegs.'), ''.join('<li%s><b>%s</b><span>%s</span></li>' % (' class="bald"' if b else '', d, E(t)) for d, t, b in aussen))

    inhalt = k + session + konz + gast + fest + unterwegs + weiter('Was als Nächstes kommt.', 'Neue Abende kündigt die Bar zuerst auf Instagram an. Ohne Programm ist sie donnerstags bis samstags ab 19 Uhr einfach offen.',
                                                                  [('Auf Instagram', HAUS['instagram'] + '" target="_blank" rel="noopener', ''), ('Platz reservieren', 'besuch.html#reservieren', 'schild')])
    return rahmen('Programm · Walk on the Wild Side Hannover', 'SESSION – Sip & Sound, Konzerte, Gastschichten und die Feste der Bar Walk on the Wild Side in Linden.', inhalt, 'programm.html', ' class="unter"')


