<h1 class="sk-titel blau">%s</h1><p class="at-satz">DJ-Abende, kleine Konzerte, Gäste hinter dem Tresen und die Feste der Bar. Angekündigt wird alles auf Instagram, gesammelt hier.</p>
<p class="eng at-zeit">%s</p><div class="knoepfe">%s</div></div>%s</div></div></section>''' % (
        wellen(), zl('Programm'), HAUS['zeit_kurz'], knopf('Zum Line-up', '#session') + knopf('Auf Instagram', HAUS['instagram'], 'schild" target="_blank" rel="noopener'),
        bild('saengerin-sw', 'fw-bild', '42vw', True, 'position:relative;inset:auto'))

    zeilen = ''.join('<li data-p="%s"%s><b>%s</b><span>%s</span><em>%s</em></li>' % (POSTER.get(d, ''), ' class="an"' if n == 0 else '', d[:6] + d[8:], E(nm), E(z)) for n, (d, nm, z) in enumerate(LINEUP))
    poster = ''.join(bild(p, 'ab' + (' an' if n == 0 else ''), '30vw', False, 'position:absolute').replace('<figure ', '<figure data-pk="%s" ' % p, 1) for n, p in enumerate(POSTER.values()))
    session = '''<section class="kap p-session" id="session"><div class="ps-gr">
<div class="ps-links"><h2 class="session-titel zl auf">%s</h2>
<p class="vtext sw auf" style="--i:1">Die Regel: rund einmal im Monat, meistens samstags, von 21 bis 1 Uhr. Ein DJ am Deck, Momo an der Bar, Eintritt frei. Angefangen hat es am 6. September 2025 mit Björn vom This Is Social Club.</p>
<ul class="lineup ps-liste sw auf" style="--i:2">%s</ul></div>
<div class="ps-poster"><div class="ps-rahmen">%s</div><p class="eng">Die Plakate der Abende</p></div></div></section>''' % (zl('Session', '<small>Sip &amp; Sound</small>'), zeilen, poster)

    konzerte = [('07.03.2024', 'Dornröschen-Trio', 'Jazz'), ('14.03.2024', 'Sini', 'Wohnzimmerkonzert'), ('28.03.2024', 'Alone Together', 'Jazz, Soul, Pop'),
                ('13.06.2024', 'Alone Together', 'Michelle und Max'), ('28.06.2024', 'Anissa Al Jay', 'Pop, Soul'), ('29.08.2024', 'Josseff and Friends', 'Neo Soul'),
                ('20.02.2025', 'Sina and Friends', 'Konzertabend')]
    konz = '''<section class="kap p-konzerte" id="konzerte"><div class="pk-gr">
<div class="pk-bilder flaeche auf">%s%s%s</div>
<div class="pk-text"><h2 class="titel zl auf">%s</h2><p class="vtext sw auf" style="--i:1">2024 und Anfang 2025 spielten donnerstags Duos und kleine Bands mitten im Raum, meist um halb neun, Eintritt frei. Plätze reservieren war die beste Idee.</p>
<ul class="pk-liste sw auf" style="--i:2">%s</ul></div></div></section>''' % (
        bild('konzert-love', 'foto pk-1', '30vw'), bild('konzert', 'foto pk-2', '30vw'), bild('saengerin', 'foto pk-3', '20vw'), zl('Konzerte', 'am Donnerstag.'),
        ''.join('<li><b>%s</b><span>%s</span><em>%s</em></li>' % (d, E(n), E(z)) for d, n, z in konzerte))

    gaeste = [('gast-musa', '02.03.2024', 'Musa', 'Rebe & Brot, Hannover. Mit Momo hinter der Bar, «sexy, ausgefallene Drinks».'),
              ('gast-havn', '09.03.2024', 'Gastschicht aus dem Havn', 'Eine Bartenderin aus dem Havn in Hannover, zusammen mit Momo.'),
              ('gast-nils', '20.04.2024', 'Nils Lutterbach', 'Lovis, Berlin. Nach Jahren wieder mit Momo an einer Bar, vier Signature Drinks mit Freimeister Kollektiv.'),
              ('gast-cold', '25.05.2024', 'Cold Drinks and More', 'Ein alter Bekannter aus Berlin mit fünf Signature Drinks.'),
              ('gast-enlil', '19.10.2024', 'Enlil Arevalo', 'Eine Legende der Barszene Hannovers, fünf Signature Drinks.')]
    gast = '''<section class="kap p-gaeste" id="gaeste"><div class="innen pg-kopf"><h2 class="titel zl auf">%s</h2><div class="gast-pfeile"><button type="button" data-band="-1" aria-label="Zurück">%s</button><button type="button" data-band="1" aria-label="Weiter">%s</button></div></div>
<div class="gast-band staffel auf">%s</div>
<div class="innen"><p class="vtext sw auf pg-dazu">Dazu Abende mit Partnern: Paragon von Monin und Sipsmith am 23.09.2024, die Paloma-Nacht mit 1800 Tequila am 20.06.2025, Mystic Mella mit Tarot und Paragon-Drinks am 20.03.2026.</p></div></section>''' % (
        zl('Gäste hinterm Tresen.'), PFEIL.replace('d="M4 12h15M13 6l6 6-6 6"', 'd="M20 12H5M11 6l-6 6 6 6"'), PFEIL,
        ''.join('<article class="gast" style="--i:%d">%s<p class="eng">%s</p><h3>%s</h3><p class="gast-bar">%s</p></article>' % (n, bild(b, 'foto', '24vw'), d, E(nm), E(t)) for n, (b, d, nm, t) in enumerate(gaeste)))

    feste = [('31.12.', 'Silvester ab mittags', '2024 als Frühshoppen von 12 bis 19 Uhr mit Buffet von Rudi, 2025 von 12 bis 20 Uhr mit dem Foodtruck von Tru Story vor der Tür.', 'silvester'),
