    abend = '''<section class="kap d-karte"><div class="dk-gr">
<div class="dk-text"><h2 class="titel zl auf">%s</h2><p class="vtext sw auf" style="--i:1">Eine gedruckte Karte gibt es nur zu besonderen Abenden. Zum Valentinstag 2026 hiess sie «Drunk in Love», dazu kochte Rudi kleine Dishes zum Teilen.</p></div>
<div class="dk-blatt auf"><div class="dk-innen"><p class="dk-kopf">Drunk in Love</p><p class="eng dk-unter">Cupid’s Signature Drinks · 14.02.2026</p>%s</div></div>
</div></section>''' % (zl('Eine Karte', 'für einen Abend.'),
                       ''.join('<div class="dk-zeile"><p><b>%s</b><span>%s</span></p><em>12</em></div>' % (E(n), E(z)) for n, z in karte))

    klassiker = '''<section class="kap d-klassik"><div class="innen"><h2 class="titel zl auf">%s</h2></div>
<div class="kl-gr">
