# ---------------------------------------------------------------- Rechtliches
def recht(titel, absaetze, name):
    inhalt = '''<section class="kap recht"><div class="innen recht-in"><h1 class="titel">%s</h1>%s</div></section>''' % (
        E(titel), ''.join('<h2 class="eng">%s</h2><p>%s</p>' % (E(h), t) for h, t in absaetze))
    return rahmen('%s · Walk on the Wild Side Hannover' % titel, titel, inhalt, name, ' class="unter recht-seite"')


