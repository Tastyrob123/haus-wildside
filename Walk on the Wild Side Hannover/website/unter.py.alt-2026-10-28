        ('Angaben gemäss § 5 DDG', 'Walk on the Wild Side<br>Haasemannstraße 13<br>30449 Hannover<br><br>Betreiber und Rechtsform: werden vor dem Online-Gehen mit der Bar ergänzt.'),
        ('Kontakt', 'Telefon: <a href="tel:%s">%s</a><br>Instagram: <a href="%s" target="_blank" rel="noopener">@walkonthewildside_hannover</a>' % (HAUS['tel_href'], HAUS['telefon'], HAUS['instagram'])),
