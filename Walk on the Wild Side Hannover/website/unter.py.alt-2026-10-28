"""Walk on the Wild Side · Unterseiten: Drinks, Programm, Die lange Tafel, Das Haus, Besuch, Impressum, Datenschutz.
Jede Seite beginnt mit einem grossen Kopf (Bilder füllen den Raum, Titel gross darüber), jeder Abschnitt hat seine eigene Anordnung.
Fakten mit Quelle in _quelle/ (Notizen, research_notes, ig/beitraege.md)."""
from bau import E, HAUS, LINEUP, PFEIL, bild, img_tag, knopf, mache, rahmen, verh, wellen


def zl(*zeilen, i0=0):
    return ''.join('<span class="z"><span style="--i:%d">%s</span></span>' % (i0 + n, z) for n, z in enumerate(zeilen))


def kopf(cls, titel_zeilen, satz, bilder_html, extra=''):
    """Seitenkopf: ein Bildschirm, Bilder füllen den Raum, Titel gross darüber. Geht von selbst auf (Klasse .fassung → .offen)."""
    return '''<section class="seitenkopf" aria-label="%s"><div class="fassung sk %s" data-nr="1" data-name="Kopf">%s
<div class="sk-text hof"><h1 class="sk-titel">%s</h1><p class="sk-satz">%s</p>%s</div></div></section>''' % (
        E(' '.join(titel_zeilen)), cls, bilder_html, ''.join('<span class="z"><span style="--i:%d">%s</span></span>' % (n, E(z)) for n, z in enumerate(titel_zeilen)), E(satz), extra)


def weiter(titel, satz, links):
    """Abschluss jeder Unterseite: ein Satz, die Zeiten, zwei Wege weiter."""
    return '''<section class="kap weiter"><div class="innen weiter-in"><h2 class="titel zl auf">%s</h2><p class="vtext sw auf" style="--i:1">%s</p>
<p class="eng weiter-zeit sw auf" style="--i:2"><span data-heute-satz>Do bis Sa ab 19 Uhr</span> · %s · %s</p><div class="knoepfe sw auf" style="--i:3">%s</div></div></section>''' % (
        zl(titel), E(satz), HAUS['zeit_kurz'], HAUS['adresse'], ''.join(knopf(t, h, c) for t, h, c in links))


# ---------------------------------------------------------------- Drinks
